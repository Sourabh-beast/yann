# Database Configuration
MONGODB_URI=your_mongodb_connection_string

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Email Configuration (for sending OTP via email)
# For Gmail: Use App Password (not your regular password)
# To create App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# MSG91 Configuration (for sending OTP via SMS)
    MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Support Contact
SUPPORT_EMAIL=support@yannservices.com
COMPANY_ADDRESS=YANN Services, Gurugram, India

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Node Environment
NODE_ENV=development

# Redis (rate limiting + caching) - REQUIRED in production for rate limiting
# and caching to actually be enforced/shared across serverless instances;
# without it the app silently falls back to per-instance in-memory behavior.
REDIS_URL=redis://user:password@host:port

# Razorpay (payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin panel credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_admin_password

# Sentry error monitoring - now actually wired up via src/instrumentation.js.
# Without NEXT_PUBLIC_SENTRY_DSN set, Sentry.init() runs but has nowhere to send events.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_ENABLED=true

