# Database Configuration
MONGODB_URI=your_mongodb_connection_string

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Email Configuration (for sending OTP via email)
# For Gmail: Use App Password (not your regular password)
# To create App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# MSG91 Configuration (for sending OTP via SMS)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Support Contact
SUPPORT_EMAIL=support@yannservices.com
COMPANY_ADDRESS=YANN Services, Gurugram, India

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Node Environment
NODE_ENV=development
